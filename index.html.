];let i=0,points=0,locked=false;const $=id=>document.getElementById(id);function show(id){['start','game','result'].forEach(x=>$(x).classList.toggle('hidden',x!==id))}function render(){locked=false;const item=questions[i];$('counter').textContent=`${i+1} / ${questions.length}`;$('fill').style.width=(i/questions.length*100)+'%';$('question').textContent=item.q;$('answers').innerHTML='';$('feedback').classList.add('hidden');$('next').classList.add('hidden');item.a.forEach((s,j)=>{const b=document.createElement('button');b.className='answer';b.textContent=String.fromCharCode(65+j)+'. '+s;b.onclick=()=>choose(j);$('answers').appendChild(b)})}function choose(j){if(locked)return;locked=true;const item=questions[i];if(j===item.c)points++;[...$('answers').children].forEach((b,k)=>{b.disabled=true;if(k===item.c)b.classList.add('correct');else if(k===j)b.classList.add('wrong')});$('feedback').textContent=(j===item.c?'✅ Верно! ':'❌ Не совсем. ')+item.e;$('feedback').classList.remove('hidden');$('next').textContent=i===questions.length-1?'Узнать результат →':'Следующее дело →';$('next').classList.remove('hidden')}function finish(){$('counter').textContent='Финиш';$('rank').textContent=points>=9?'🏅 Мастер кибербезопасности':points>=7?'🔎 Опытный кибердетектив':points>=4?'🧩 Начинающий кибердетектив':'🌱 Ученик кибердетектива';$('score').textContent=`Правильных ответов: ${points} из ${questions.length}`;$('summary').textContent='Главное правило: не спеши доверять незнакомцам и подозрительным сообщениям, береги личные данные и обращайся за помощью при угрозах.';show('result')}function restart(){i=0;points=0;show('game');render()}$('startBtn').onclick=restart;$('again').onclick=restart;$('next').onclick=()=>{i++;i<questions.length?render():finish()};
